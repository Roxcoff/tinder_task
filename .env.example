# --- Base de données ---
# En local : créez une base Postgres gratuite (ex. Neon, Supabase) et collez son URL ici.
# Sur Vercel : cette variable est injectée automatiquement quand vous créez une base
# dans l'onglet Storage du projet (ex. "Prisma Postgres") — rien à taper en prod.
POSTGRES_URL="postgresql://user:password@host/db?sslmode=require"

# --- Notifications push ---
# Générées avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:vous@exemple.com"

# --- Session ---
# Chaîne aléatoire longue, ex. générée avec: openssl rand -hex 32
SESSION_SECRET="changez-moi-en-une-longue-chaine-aleatoire"

# --- Accès ---
# Code demandé à la connexion, en plus du nom. Laissez vide pour désactiver ce contrôle.
ACCESS_CODE=""
