generator client {
  provider = "prisma-client-js"
}

// Ce projet est pensé pour une base Postgres provisionnée via l'onglet
// Storage de Vercel. Selon le fournisseur choisi, les noms de variables
// injectées varient — avec "Prisma Postgres", Vercel fournit POSTGRES_URL
// (connexion directe standard, utilisée ici à la fois pour l'app et les
// migrations).
datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

enum Programme {
  mkd
  serenity
  mizzy
}

enum Statut {
  a_demarrer
  en_cours
  bloque
  termine
}

enum NotificationType {
  assignation
  statut
}

model User {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  tasksCreated      Task[]             @relation("createdBy")
  tasksAssigned     Task[]             @relation("assignees")
  events            TaskEvent[]
  comments          Comment[]
  pushSubscriptions PushSubscription[]
  notificationsSent Notification[]     @relation("from")
  notificationsRecv Notification[]     @relation("to")
  pendingStatusNotifications PendingStatusNotification[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Task {
  id          String    @id @default(cuid())
  programme   Programme
  chantier    String
  titre       String
  echeance    DateTime?
  statut      Statut    @default(a_demarrer)
  notes       String?
  personnelle Boolean   @default(false)
  archived    Boolean   @default(false)
  assignees   User[]    @relation("assignees")
  createdById String
  createdBy   User      @relation("createdBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  events        TaskEvent[]
  comments      Comment[]
  notifications Notification[]
  pendingStatusNotifications PendingStatusNotification[]
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  texte     String
  createdAt DateTime @default(now())
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  statut    Statut
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Notification {
  id         String           @id @default(cuid())
  type       NotificationType
  message    String
  taskId     String?
  task       Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  toUserId   String
  toUser     User             @relation("to", fields: [toUserId], references: [id])
  fromUserId String
  fromUser   User             @relation("from", fields: [fromUserId], references: [id])
  createdAt  DateTime         @default(now())
  readAt     DateTime?
}

// Un changement de statut ne notifie immédiatement que les personnes déjà
// impliquées (assignés, créateur). Pour les autres utilisateurs, on
// n'envoie une notification que si le statut n'a pas été modifié à nouveau
// dans les 30 minutes qui suivent (voir src/lib/statusNotify.js) — cela
// évite de notifier tout le monde en cas d'erreur de manipulation corrigée
// rapidement.
model PendingStatusNotification {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  statut    Statut
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  createdAt DateTime @default(now())
}
